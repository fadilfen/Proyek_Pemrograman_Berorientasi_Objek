<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <!-- Satu source root mencakup tubes_a11/ dan database/ -->
    <classpathentry kind="src" path="gui/src"/>
    <!-- Output folder untuk file .class -->
    <classpathentry kind="output" path="gui/bin"/>
    <!-- JRE System Library -->
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
    <!-- MySQL Connector/J untuk koneksi ke Laragon -->
    <classpathentry kind="lib" path="gui/lib/mysql-connector.jar"/>
</classpath>
